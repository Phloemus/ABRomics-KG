    <!-- http://purl.obolibrary.org/obo/ARO_3004012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clofazimine is a fluoroquinolone-class phenazine dye used for the treatment of leprosy. Clofazimine binds to DNA and disrupts bacterial DNA gyrase, thereby causing double-stranded DNA breaks, and subsequent cell death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:2794</oboInOwl:hasDbXref>
