    <!-- http://purl.obolibrary.org/obo/ARO_3004044 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000872"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fabI is a bacterial enoyl-acyl carrier reductase (ENR) isozyme. As with other ENRs, mutations in fabI can confer resistance to the biocide triclosan.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
