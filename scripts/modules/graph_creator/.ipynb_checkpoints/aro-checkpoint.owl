        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isoniazid resistant inbR</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004900 -->

