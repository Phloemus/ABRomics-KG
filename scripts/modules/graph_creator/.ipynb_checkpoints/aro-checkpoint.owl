    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3002976"/>
