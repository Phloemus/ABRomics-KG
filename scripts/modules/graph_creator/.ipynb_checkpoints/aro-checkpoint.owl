        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic-resistant GlpT</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
