    <!-- http://purl.obolibrary.org/obo/ARO_3007021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3005432"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PFM-4 (BioF) is a class B2 metallo-beta-lactamase first identified in Pseudomonas. It belongs to the PFM-like beta-lactamase gene family. It confers resistance to carbapenems and some cephalosporins.</obo:IAO_0000115>
