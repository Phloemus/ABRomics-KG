    <!-- http://purl.obolibrary.org/obo/ARO_3000630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000041"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bacitracin B is a component of bacitracin, an antibiotic mixture that interferes with bacterial cell wall synthesis. It differs from Bacitracin A with a valine instead of an isoleucine in its peptide.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:121232829</oboInOwl:hasDbXref>
