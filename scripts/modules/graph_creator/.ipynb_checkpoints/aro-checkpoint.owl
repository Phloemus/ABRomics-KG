        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007163"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Albendazole is a compound used in the treatment of parasitic worm infestations. It has been shown to exhibit antibiotic activity against Escherichia coli by inhibiting MurA (MurZ), thereby disrupting cell wall synthesis.</obo:IAO_0000115>
