    <!-- http://purl.obolibrary.org/obo/ARO_3007725 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The maximum number of blaOXA belonged to the OXA-51-like subfamily. An earlier study had reported that OXA-51-like enzymes were present exclusively in A. baumannii. Similar to most of the other OXA-type carbapenemases, the OXA-51-like enzymes show weak carbapenemase activity; however, the presence of the insertion sequence ISAba1 upstream of the blaOXA-51-like gene may provide a promoter that allows the overproduction of carbapenemase, and this results in carbapenem resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007725</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OXA-51-like beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007725"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The maximum number of blaOXA belonged to the OXA-51-like subfamily. An earlier study had reported that OXA-51-like enzymes were present exclusively in A. baumannii. Similar to most of the other OXA-type carbapenemases, the OXA-51-like enzymes show weak carbapenemase activity; however, the presence of the insertion sequence ISAba1 upstream of the blaOXA-51-like gene may provide a promoter that allows the overproduction of carbapenemase, and this results in carbapenem resistance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:17724156</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:24696435</oboInOwl:hasDbXref>
    </owl:Axiom>
    


