        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flomoxef is an oxacephem antibiotic which was effective in preventing the growth of all ESBL-producing strains and is widely active against Gram-positive, Gram-negative, and anaerobic bacteria.</owl:annotatedTarget>
