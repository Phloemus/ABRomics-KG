        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3001326</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ganefromycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3001326"/>
