    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
