        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antibiotics belonging to the thiazolide group. Note that many thiazolides are used as antiviral compounds, however some have also exhibited antibacterial activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007177</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thiazolide antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007177"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitazoxanide is a thiazolide antiparatasitic and antiviral drug that has demonstrated antibacterial activity against Helicobacter pylori. It is well tolerated and exhibits a synergistic effect with other antibiotics, such as clarithromycin.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:41684</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alinia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nizonide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nitazoxamide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007178</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nitazoxanide</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitazoxanide is a thiazolide antiparatasitic and antiviral drug that has demonstrated antibacterial activity against Helicobacter pylori. It is well tolerated and exhibits a synergistic effect with other antibiotics, such as clarithromycin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:35587063</oboInOwl:hasDbXref>
    </owl:Axiom>
    


