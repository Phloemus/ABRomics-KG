        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_participates_in"/>
