    <!-- http://purl.obolibrary.org/obo/ARO_3003324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000863"/>
