                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007155"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gpsI codes for polyribonucleotide nucleotidyltransferase which is a protein involved in mRNA degradation. It catalyzes the phosphorolysis of single-stranded polyribonucleotides in the 3&apos;- to 5&apos;-direction.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
