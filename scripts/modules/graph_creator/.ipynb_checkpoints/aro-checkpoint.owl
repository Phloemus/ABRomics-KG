    <!-- http://purl.obolibrary.org/obo/ARO_3001319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3001318"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A narrow spectrum antibiotic effective against  Clostridioides difficile infection (CDI). It is active against gram positive and gram negative bacteria by inhibiting RNA polymerase&apos;s switch region leading to cell death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:10034073</oboInOwl:hasDbXref>
