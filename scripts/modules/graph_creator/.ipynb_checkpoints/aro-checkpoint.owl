    <!-- http://purl.obolibrary.org/obo/ARO_3003272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
