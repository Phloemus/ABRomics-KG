    <!-- http://purl.obolibrary.org/obo/ARO_3000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000133"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A thiol transferase that leads to the resistance of fosfomycin. Contrasting FosA, FosB is dependent on the cofactor Magnesium (II) and uses either bacillithiol or  L-cysteine to open up the epoxide ring of fosfomycin.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PDB:4JH1</oboInOwl:hasDbXref>
