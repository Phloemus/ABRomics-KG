    <!-- http://purl.obolibrary.org/obo/ARO_3003897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000079"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tedizolid is a synthetic oxazolidinone antibiotic that is administered to the patient as a prodrug that is activated in vivo. It acts as an inhibitor of protein synthesis by binding the 50S subunit of the ribosome and preventing formation of the 70S initiation complex. It is active against Gram-positive pathogens.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:11234049</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003897</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tedizolid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003897"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tedizolid is a synthetic oxazolidinone antibiotic that is administered to the patient as a prodrug that is activated in vivo. It acts as an inhibitor of protein synthesis by binding the 50S subunit of the ribosome and preventing formation of the 70S initiation complex. It is active against Gram-positive pathogens.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22324973</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:27904526</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003898 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000053"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lugdunin is a thiazolidine-containing cyclic peptide antibiotic isolated from nasal Staphylococcus lugnunensis that prohibits Staphylococcus aureus colony formation. It is a human commensal bacteria, indicating the potential for further antibiotic discoveries from human microbiota.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:121596231</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003898</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lugdunin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003898"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lugdunin is a thiazolidine-containing cyclic peptide antibiotic isolated from nasal Staphylococcus lugnunensis that prohibits Staphylococcus aureus colony formation. It is a human commensal bacteria, indicating the potential for further antibiotic discoveries from human microbiota.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:27466123</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003899 -->

