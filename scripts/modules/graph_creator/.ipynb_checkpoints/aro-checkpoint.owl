        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Benzylpenicillin, commonly referred to as penicillin G, is effective against both Gram-positive and Gram-negative bacteria. It is unstable in acid.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:5904</oboInOwl:hasDbXref>
