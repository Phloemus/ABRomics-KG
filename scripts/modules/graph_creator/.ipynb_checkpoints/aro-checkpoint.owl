    <!-- http://purl.obolibrary.org/obo/ARO_3000370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
