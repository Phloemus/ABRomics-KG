        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_regulates"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3001209"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000268"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mecI acts as a repressor of transcription of the mecA/mecR1/mecI operon.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mecI</oboInOwl:hasExactSynonym>
