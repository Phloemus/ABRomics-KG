    <!-- http://purl.obolibrary.org/obo/ARO_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000080"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Puromycin is an aminonucleoside antibiotic, derived from Streptomyces alboniger, that causes premature chain termination during ribosomal protein translation.</obo:IAO_0000115>
