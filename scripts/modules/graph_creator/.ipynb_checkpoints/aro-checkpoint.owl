    <!-- http://purl.obolibrary.org/obo/ARO_3003678 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TriABC-OpmH is a triclosan-specific efflux pump expressed in the Gram-negative Pseudomonas aeruginosa. TriABC is the only P. aeruginosa resistance nodulation cell division (RND) pump which contains two membrane fusion proteins, TriA and TriB, and both are required for efflux pump function. TriABC associated with OpmH assemble a functional triclosan efflux pump.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TriABC-OpmH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003678</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TriABC-OpmH</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TriABC-OpmH is a triclosan-specific efflux pump expressed in the Gram-negative Pseudomonas aeruginosa. TriABC is the only P. aeruginosa resistance nodulation cell division (RND) pump which contains two membrane fusion proteins, TriA and TriB, and both are required for efflux pump function. TriABC associated with OpmH assemble a functional triclosan efflux pump.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:17720796</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
