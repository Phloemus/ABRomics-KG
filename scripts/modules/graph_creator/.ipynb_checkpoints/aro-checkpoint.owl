                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific fusidic acid resistance gene conferring intrinsic resistance in the bacteria Staphylococcus saprophyticus. FusD behaves by causing dissociation of EF-G from the ribosome thus counteracting the action of Fusidic acid. It is considered a FusB-type protein.</obo:IAO_0000115>
