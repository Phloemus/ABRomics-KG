    <!-- http://purl.obolibrary.org/obo/ARO_3007750 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007750">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007136"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Betaxolol is a selective beta1 receptor blocker used in the treatment of hypertension and angina, with a 50% inhibitory concentration (IC50) of 19.3 plus or minus 0.9 uM significantly inhibiting the hydrolytic activity of the NDM-1 enzyme and may represent a potential NDM-1 enzyme inhibitor. BET combined with meropenem (MEM) showed bactericidal synergism in vitro. BET inhibited NDM-1 by competitively binding to it and that it can be developed in combination with MEM as a new therapy.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:2369</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007750</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">betaxolol</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007750"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Betaxolol is a selective beta1 receptor blocker used in the treatment of hypertension and angina, with a 50% inhibitory concentration (IC50) of 19.3 plus or minus 0.9 uM significantly inhibiting the hydrolytic activity of the NDM-1 enzyme and may represent a potential NDM-1 enzyme inhibitor. BET combined with meropenem (MEM) showed bactericidal synergism in vitro. BET inhibited NDM-1 by competitively binding to it and that it can be developed in combination with MEM as a new therapy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:37686201</oboInOwl:hasDbXref>
    </owl:Axiom>
    


