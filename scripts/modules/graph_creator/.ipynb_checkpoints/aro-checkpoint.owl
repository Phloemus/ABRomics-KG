        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic sensitive inhA</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000708"/>
