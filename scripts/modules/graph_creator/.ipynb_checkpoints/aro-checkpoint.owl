    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_regulates"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004248"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UhpA acts as a positive regulator of UhpT, which is a transporter to bring fosfomycin drugs into bacterial cells. Mutations in UhpA that negatively impact the expression of UhpT can confer resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004249</oboInOwl:id>
