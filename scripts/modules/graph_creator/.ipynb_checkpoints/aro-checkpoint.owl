        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000040"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanism of enzymatic degradation common to Ambler Class B beta-lactamases. One or two zinc atoms are used to orient a hydroxide nucleophile for attack of the beta-lactam ring.  In contrast to serine beta-lactamases, no acyl-enzyme intermediate is formed.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000203</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrolysis of beta-lactam antibiotic by metallo-beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mechanism of enzymatic degradation common to Ambler Class B beta-lactamases. One or two zinc atoms are used to orient a hydroxide nucleophile for attack of the beta-lactam ring.  In contrast to serine beta-lactamases, no acyl-enzyme intermediate is formed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20564281</oboInOwl:hasDbXref>
    </owl:Axiom>
    


