    <!-- http://purl.obolibrary.org/obo/ARO_3007491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004232"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_regulates"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3006538"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000550"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ampR is a regulatory gene that plays an essential role in regulating antibiotic resistance in P. aeruginosa. Mutation in ampR leads to its loss of control over blaPDC-16, allowing overexpression of blaPDC-16 and further resistance to aztreonam.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paer_ampR_ATM</oboInOwl:hasExactSynonym>
