            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cardiolipin synthase (cls) is an inner membrane protein involved in membrane synthesis and phosopholipid metabolism, with mutations to the gene being capable of conferring daptomycin resistance.</obo:IAO_0000115>
