        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enmetazobactam</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enmetazobactam is a beta-lactamase inhibitor which exhibits activity against class A extended spectrum beta-lactamases. It is currently in clinical trials in combination with cefepine for the treatment of urinary tract infections and acute pyelonephritis.</owl:annotatedTarget>
