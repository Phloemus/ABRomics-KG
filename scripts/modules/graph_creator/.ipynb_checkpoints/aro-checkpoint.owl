    <!-- http://purl.obolibrary.org/obo/ARO_3007412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000126"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A family of aminoglycoside 3&apos;-O-phosphotransferase enzymes which inactivate kanamycin, neomycin, paromomycin, ribostamycin and butirosin, as well as amikacin and isepomicin,  by catalyzing the ATP-dependent phosphorylation of these antibiotics, thereby conferring resistance to these compounds.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007412</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">APH(3&apos;)-VI</rdfs:label>
    </owl:Class>
    


