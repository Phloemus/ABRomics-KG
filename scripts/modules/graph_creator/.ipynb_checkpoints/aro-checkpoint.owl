            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosomal protein S12 stabilizes the highly conserved pseudoknot structure formed by 16S rRNA. It is targeted and inhibited by streptomycin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003431</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic sensitive Ribosomal protein S12 (rpsL)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003436">
