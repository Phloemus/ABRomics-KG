    <!-- http://purl.obolibrary.org/obo/ARO_3004882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004881"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007155"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mas is a multifunctional mycocerosic acid synthase membrane-associated mas. It catalyzes the elongation of N-fatty acyl-CoA with methylamalonyl-CoA as the elongating agent to form mycocerosyl fatty acids present in mycobacterium.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004882</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pyrazinamide resistant mas</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004883 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3005002"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mutations that occur in the ppsC that increases resistance to antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004883</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic resistant ppsC</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004884 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004883"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ppsC codes for the phthiocerol synthesis polyketide synthase type 1. It is involved in the elongation of C22-24 fatty acids by the addition of methylmalonyl-CoA extender units to yield phthiocerol derivatives in a complete reduction. Research has pointed towards this protein to be a high confidence drug target.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004884</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pyrazinamide resistant ppsC</rdfs:label>
    </owl:Class>
    


