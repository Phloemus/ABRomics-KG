    <!-- http://purl.obolibrary.org/obo/ARO_3000770 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000051"/>
            </owl:Restriction>
