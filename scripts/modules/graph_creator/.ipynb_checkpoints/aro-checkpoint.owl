    <!-- http://purl.obolibrary.org/obo/ARO_3000490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000053"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tuberactinomycins are a family of cyclic peptide antibiotics that are important in the treatment of tuberculosis. Tuberactinomycins contain nonproteinogenic amino acids and inhibit group I self-splicing RNA to disrupt prokaryotic protein synthesis.</obo:IAO_0000115>
