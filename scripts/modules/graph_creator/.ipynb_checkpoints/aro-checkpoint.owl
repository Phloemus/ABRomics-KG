            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshB is a deacetylase that is involved in the second step of mycothiol synthesis. GlcNAc-Ins is deacetylated by MshB to produce GlcN-Ins.</obo:IAO_0000115>
