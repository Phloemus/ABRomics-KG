        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flomoxef is an oxacephem antibiotic which was effective in preventing the growth of all ESBL-producing strains and is widely active against Gram-positive, Gram-negative, and anaerobic bacteria.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:65864</oboInOwl:hasDbXref>
