    <!-- http://purl.obolibrary.org/obo/ARO_3003958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003956"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oleic acid is a fatty acid that occurs naturally in various animal and vegetable fats and oils. Oleic acid is found to have antibacterial activity, particularly in inhibiting the growth of several Gram-positive bacterial species.</obo:IAO_0000115>
