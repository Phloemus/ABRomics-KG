    <!-- http://purl.obolibrary.org/obo/ARO_3007320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003932"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007223"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007225"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phenylalanine-arginine beta-naphthylamide is a widely-used experimental efflux pump inhibitor. It has also been shown to increase Gram-negative membrane permeability and enhance the entry of antibiotics, even in efflux pump deficient strains. It is also able to inhibit the formation of bacterial biofilms and disrupt quorum sensing.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:443301</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007320</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">phenylalanine-arginine beta-naphthylamide</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007320"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phenylalanine-arginine beta-naphthylamide is a widely-used experimental efflux pump inhibitor. It has also been shown to increase Gram-negative membrane permeability and enhance the entry of antibiotics, even in efflux pump deficient strains. It is also able to inhibit the formation of bacterial biofilms and disrupt quorum sensing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:23544160</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:33889361</oboInOwl:hasDbXref>
    </owl:Axiom>
    


