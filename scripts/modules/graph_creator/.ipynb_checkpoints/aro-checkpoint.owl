        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A class of compounds containing an aromatic moiety and an aliphatic chain, produced as a bacterial metabolite and exhibiting antibiotic properties to many gram-positive pathogens.</obo:IAO_0000115>
