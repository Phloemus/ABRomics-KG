                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0012006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000979"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0012006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3001405"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enmetazobactam is a beta-lactamase inhibitor which exhibits activity against class A extended spectrum beta-lactamases. It is currently in clinical trials in combination with cefepine for the treatment of urinary tract infections and acute pyelonephritis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:23653540</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
