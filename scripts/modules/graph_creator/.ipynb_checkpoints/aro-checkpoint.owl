    <!-- http://purl.obolibrary.org/obo/ARO_3007091 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007159"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diflunisal is a salicylic acid derivative and aspirin analogue typically used as a nonsteroidal anti-inflammatory drug. It has been shown to exhibit antibiotic activity against Escherichia coli by inhibiting MurA (MurZ), thereby disrupting cell wall synthesis.</obo:IAO_0000115>
