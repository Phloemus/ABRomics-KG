    <!-- http://purl.obolibrary.org/obo/ARO_3000337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000171"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iclaprim is a bactericidal compound that inhibits dihydrofolate reductase. It is used against clinically important Gram-positive pathogens, including methicillin-sensitive Staphylococcus aureus and methicillin-resistant S. aureus.</obo:IAO_0000115>
