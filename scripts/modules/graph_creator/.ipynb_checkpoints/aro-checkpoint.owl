    <!-- http://purl.obolibrary.org/obo/ARO_3007382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000707"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gentamicin is a commonly used aminoglycoside antibiotic derived from members of the Micromonospora genus of bacteria. It acts by binding the 30S ribosomal subunit, thus inhibiting protein synthesis. Gentamicin is typically used to treat Gram-negative infections of the repiratory and urinary tract, as well as infections of the bone and soft tissue. It also exhibits considerable nephrotoxicity and ototoxicity. Gentamicin is administered as a mixture of gentamicin type C (which makes about around 80% of the complex) and types A, B, and X (distributed in the remaining 20% of the complex).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:3467</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cidomycin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Garamycin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gentacycol</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gentamicins</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gentamicinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gentavet</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007382</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gentamicin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007382"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gentamicin is a commonly used aminoglycoside antibiotic derived from members of the Micromonospora genus of bacteria. It acts by binding the 30S ribosomal subunit, thus inhibiting protein synthesis. Gentamicin is typically used to treat Gram-negative infections of the repiratory and urinary tract, as well as infections of the bone and soft tissue. It also exhibits considerable nephrotoxicity and ototoxicity. Gentamicin is administered as a mixture of gentamicin type C (which makes about around 80% of the complex) and types A, B, and X (distributed in the remaining 20% of the complex).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:28507482</oboInOwl:hasDbXref>
    </owl:Axiom>
    


