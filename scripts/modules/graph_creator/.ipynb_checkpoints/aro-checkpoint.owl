    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007380"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bifunctional aminoglycoside-inactivating enzymes composed of two separate functional domains. These proteins possess activity from both enzyme components, thereby conferring resistance to the combination of antibiotics from both domains, and may include acetylation, phosphorylation or nucleotidylation activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
