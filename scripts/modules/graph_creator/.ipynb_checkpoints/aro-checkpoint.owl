    <!-- http://purl.obolibrary.org/obo/ARO_3007721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OXA-48-type beta-lactamases are now routinely encountered in bacterial infections caused by carbapenam-resistant Enterobacterales. OXA-48-like proteins confer resistance to penicillin (which is efficiently hydrolyzed) and carbapenam antibiotics (which is more slowly broken down). The spectrum of activity of these variants varies, with some hydrolyzing expanded-spectrum oxyimino-cephalosporins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007721</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OXA-48-like beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007721"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OXA-48-type beta-lactamases are now routinely encountered in bacterial infections caused by carbapenam-resistant Enterobacterales. OXA-48-like proteins confer resistance to penicillin (which is efficiently hydrolyzed) and carbapenam antibiotics (which is more slowly broken down). The spectrum of activity of these variants varies, with some hydrolyzing expanded-spectrum oxyimino-cephalosporins.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:33753332</oboInOwl:hasDbXref>
    </owl:Axiom>
    


