    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_0001002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0001002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Replacement or substitution of antibiotic action target, which process will result in antibiotic resistance.</obo:IAO_0000115>
