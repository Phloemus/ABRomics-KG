        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007223"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PBT2 is a former Alzheimer&apos;s and Huntington&apos;s disease candidate drug that has since been shown to increase susceptibility to colistin, polymyxin B, and tetracycline in N. gonorrhoeae. It is thought to inactivate lipooligosaccharide phosphoethanolamine transferase A, resulting in alteration of cell membrane charge.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:10016012</oboInOwl:hasDbXref>
