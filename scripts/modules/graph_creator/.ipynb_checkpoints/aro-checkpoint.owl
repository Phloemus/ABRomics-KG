            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CplR is an ABC-F ATPase ribosomal protection protein from Clostridioides difficile which confers resistance to pleuromutilins and lincosamides. Its resistance to these antibiotics increases in synergy with erythromcyin resistance methylases (e.g., ermB).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cplR</oboInOwl:hasExactSynonym>
