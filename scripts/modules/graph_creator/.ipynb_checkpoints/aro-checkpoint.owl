        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:0000039</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spectinomycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_0000039"/>
