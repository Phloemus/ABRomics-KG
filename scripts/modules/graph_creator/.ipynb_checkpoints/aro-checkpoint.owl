    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3002978"/>
