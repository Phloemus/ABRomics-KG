    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000000"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tylosin is a 16-membered macrolide, naturally produced by Streptomyces fradiae. It interacts with the bacterial ribosome 50S subunit to inhibit protein synthesis.</obo:IAO_0000115>
