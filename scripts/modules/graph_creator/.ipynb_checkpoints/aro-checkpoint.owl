            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deletion of gene or gene product results in resistance. For example, deletion of a porin gene blocks drug from entering the cell.</obo:IAO_0000115>
