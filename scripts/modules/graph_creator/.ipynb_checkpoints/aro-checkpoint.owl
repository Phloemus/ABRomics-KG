    <!-- http://purl.obolibrary.org/obo/ARO_3007544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003292"/>
