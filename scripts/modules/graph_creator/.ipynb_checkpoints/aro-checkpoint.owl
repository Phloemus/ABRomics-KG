                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PtsI (phosphoenolpyruvate-protein phosphotransferase) is involved in cyclic AMP synthesis, which regulates glpT expression. As a result, mutations to ptsI confer resistance to fosfomycin by affecting the regulation of fosfomycin import.</obo:IAO_0000115>
