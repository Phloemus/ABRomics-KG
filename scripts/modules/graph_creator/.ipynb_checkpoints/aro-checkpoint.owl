                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000068"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Daptomycin binds to the cytoplasmic membrane of Gram-positive. It&apos;s lipopeptide tail servers as a ion channel for potassium. This causes a rapid depolarization that result in failures in DNA/RNA/Protein synthesis. Eventually cell death.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003278</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">daptomycin sensitive beta-subunit of RNA polymerase (rpoB)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003278"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Daptomycin binds to the cytoplasmic membrane of Gram-positive. It&apos;s lipopeptide tail servers as a ion channel for potassium. This causes a rapid depolarization that result in failures in DNA/RNA/Protein synthesis. Eventually cell death.</owl:annotatedTarget>
