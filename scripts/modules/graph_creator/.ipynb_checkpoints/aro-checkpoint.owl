        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metallophores with antibiotic activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3005171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3005171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Polyketides are a large group of secondary metabolites. Some polyketide compounds have been shown to possess antibiotic activity and qualities.</obo:IAO_0000115>
