    <!-- http://purl.obolibrary.org/obo/ARO_3003276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
