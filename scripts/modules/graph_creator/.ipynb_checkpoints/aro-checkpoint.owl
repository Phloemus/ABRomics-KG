    <!-- http://purl.obolibrary.org/obo/ARO_3007061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hp1165 is a homolog of the Clostridium perfringes tetP gene and is part of the MFS efflux family but is not considered a true tetracycline resistance gene. Hp1165 confers low level resistance to tetracycline, however cessation of antibiotic treatment results in the host cell reverting to susceptibility.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007061</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hp1165</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hp1165 is a homolog of the Clostridium perfringes tetP gene and is part of the MFS efflux family but is not considered a true tetracycline resistance gene. Hp1165 confers low level resistance to tetracycline, however cessation of antibiotic treatment results in the host cell reverting to susceptibility.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16482431</oboInOwl:hasDbXref>
    </owl:Axiom>
    


