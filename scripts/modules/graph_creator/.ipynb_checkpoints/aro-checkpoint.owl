    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_0000068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000035"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Daptomycin is a novel lipopeptide antibiotic used in the treatment of certain infections caused by Gram-positive organisms. Daptomycin interferes with the bacterial cell membrane, reducing membrane potential and inhibiting cell wall synthesis.</obo:IAO_0000115>
