    <!-- http://purl.obolibrary.org/obo/ARO_3004118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004282"/>
