        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic target replacement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_0001003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0001003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protection of antibiotic action target from antibiotic binding, which process will result in antibiotic resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:0001003</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic target protection</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_0001003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protection of antibiotic action target from antibiotic binding, which process will result in antibiotic resistance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:32587401</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_0001004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0001004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enzymatic inactivation of antibiotic to confer drug resistance.</obo:IAO_0000115>
