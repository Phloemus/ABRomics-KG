    <!-- http://purl.obolibrary.org/obo/ARO_3000586 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3001219"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pulvomycin is a polyketide antibiotic that binds elongation factor Tu (EF-Tu) to inhibit protein biosynthesis by preventing the formation of the ternary complex (EF-Tu*GTP*aa-tRNA). Phenotypically, it was shown that pulvomycin sensitivity is dominant over resistance.</obo:IAO_0000115>
