        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Opr family consists of porins in Pseudomonas species, and other Gram-negative bacteria, that exhibit a variety of substrate selectivities.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
