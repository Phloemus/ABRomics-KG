    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007134"/>
