    <!-- http://purl.obolibrary.org/obo/ARO_3007660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3005172"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clerocidin is a terpenoid antibiotic that inhibits bacterial DNA gyrase. It is a natural diterpenoid which has been shown to selectively react with single-stranded bases without targeting the double helix.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:9896400</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3007660</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">clerocidin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clerocidin is a terpenoid antibiotic that inhibits bacterial DNA gyrase. It is a natural diterpenoid which has been shown to selectively react with single-stranded bases without targeting the double helix.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12930966</oboInOwl:hasDbXref>
    </owl:Axiom>
    


