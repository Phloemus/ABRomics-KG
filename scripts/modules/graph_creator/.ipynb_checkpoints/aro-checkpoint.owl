        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cefamandole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000032"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cefetamet is a third-generation semi-synthetic beta-lactam antibiotic that inactivates inner cell wall PBPs through targeting binding, resulting in cell lysis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:5487888</oboInOwl:hasDbXref>
