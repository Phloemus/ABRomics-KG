        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mutations that occur in the ppsD that increases resistance to antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004885</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic resistant ppsD</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004885"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ppsD codes for the phthiocerol synthesis polyketide synthase type 1. It is involved in the elongation of C22-24 fatty acids by the addition of malonyl-CoA extender units to yield phthiocerol derivatives in a partial reduction.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004886</oboInOwl:id>
