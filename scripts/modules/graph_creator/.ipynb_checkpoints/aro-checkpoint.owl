        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arsinothricin is a natural product synthesized by the rhizosphere bacterium Burkholderia gladioli GSRB05 and is a broad-spectrum antibiotic effective against human pathogens such as carbapenem-resistant Enterobacter cloacae. It is a non-proteogenic amino acid and glutamate mimetic that inhibits bacterial glutamine synthetase.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:36785875</oboInOwl:hasDbXref>
