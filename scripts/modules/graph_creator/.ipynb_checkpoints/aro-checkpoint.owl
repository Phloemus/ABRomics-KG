    <!-- http://purl.obolibrary.org/obo/ARO_3003780 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007157"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A  heterocyclic antibiotic that targets mutant gyrA (type II topoisomerase) containing an S84L substitution, counteracting acquired quinolone resistance. It is effective against quinolone-resistant Gram-positive bacteria including S. aureus and E. faecalis. Due to its ability to counteract quinolone resistance by targeting the mutant form of the gyrA protein, it is classified as a reverse antibiotic (RA).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:169159</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003780</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nybomycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003780"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A  heterocyclic antibiotic that targets mutant gyrA (type II topoisomerase) containing an S84L substitution, counteracting acquired quinolone resistance. It is effective against quinolone-resistant Gram-positive bacteria including S. aureus and E. faecalis. Due to its ability to counteract quinolone resistance by targeting the mutant form of the gyrA protein, it is classified as a reverse antibiotic (RA).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:16589716</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22534508</oboInOwl:hasDbXref>
    </owl:Axiom>
    


