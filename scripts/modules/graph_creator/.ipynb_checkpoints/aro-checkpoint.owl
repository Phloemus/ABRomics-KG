    <!-- http://purl.obolibrary.org/obo/ARO_3007471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3005163"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Narasin is polyether ionophore antibiotic. It is a derivative of salinomycin with an additional methyl group. Narasin is produced by fermentation of a strain of Streptomyces aureofaciens.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pubchem.compound:65452</oboInOwl:hasDbXref>
