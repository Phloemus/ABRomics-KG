        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sent_gyrA_TRC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


