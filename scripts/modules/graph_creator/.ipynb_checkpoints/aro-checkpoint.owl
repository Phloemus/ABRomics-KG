    <!-- http://purl.obolibrary.org/obo/ARO_3003479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000219"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000451"/>
