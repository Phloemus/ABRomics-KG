    <!-- http://purl.obolibrary.org/obo/ARO_3004901 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004900"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_drug_class"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mshA is a glycosyltransferase and is involved in the first step of mycothiol biosynthesis. This is a step that is required for growth in mycobacterium tuberculosis. Resistance has been shown in the gene to isoniazid.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004901</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isoniazid resistant mshA</rdfs:label>
    </owl:Class>
    


