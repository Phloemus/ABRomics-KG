        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mutations that occur in the mshB gene that results in antibiotic resistance.</obo:IAO_0000115>
