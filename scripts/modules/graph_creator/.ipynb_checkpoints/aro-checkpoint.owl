    <!-- http://purl.obolibrary.org/obo/ARO_3000721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000708"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The cell wall is unique to bacteria and provides rigidity and protects the cell from lysis due to osmotic pressure. Its characteristic component is peptidoglycan, though cell wall structures vary significantly between Gram-positive and Gram-negative bacteria, as well as mycobacteria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000721</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell wall component targeted by antibiotic</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000721"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The cell wall is unique to bacteria and provides rigidity and protects the cell from lysis due to osmotic pressure. Its characteristic component is peptidoglycan, though cell wall structures vary significantly between Gram-positive and Gram-negative bacteria, as well as mycobacteria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:4568761</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000722 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000709"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_targeted_by_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000760"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alanine racemase (alr) converts the natural L-alanine to the D-alanine required in the pentapeptide chains in peptidoglycan. It is found in both Gram-positive and Gram-negative bacteria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000722</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cycloserine sensitive alr</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000722"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alanine racemase (alr) converts the natural L-alanine to the D-alanine required in the pentapeptide chains in peptidoglycan. It is found in both Gram-positive and Gram-negative bacteria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:19748470</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:4555420</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000723">
