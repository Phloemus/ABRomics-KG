            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNA polymerase is a multisubunit enzyme that is necessary for transcription. The beta-subunit of RNA polymerase forms the active center of the enzyme and template/transcript binding sites. This enzyme can be inactivated by antibiotics leading to cell death.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
