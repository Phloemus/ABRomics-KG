    <!-- http://purl.obolibrary.org/obo/ARO_3004906 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004906">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004905"/>
