        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic resistant rpoB</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003277">
