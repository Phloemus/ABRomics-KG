                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004130"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LamB is a negative regulator for antibiotic resistance, it serves as a porin to influx antibiotic. When down-regulated, it increases resistance to chlortetracycline, ciprofloxacin, balofloxacin and nalidixic acid. It also interacts with Odp1, an energy metabolic enzyme, creating a complex that decreases in antibiotic-resistant strains.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ecol_LamB</oboInOwl:hasExactSynonym>
