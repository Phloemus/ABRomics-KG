                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to_antibiotic"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000156"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
